@echo off
rem ------------------------------------------------------------------
rem  Orda - SENET reconnaissance. Single self-contained file.
rem
rem  The PowerShell script is embedded below as base64 and decoded to
rem  a temp file before running. Base64 is plain ASCII, so nothing can
rem  be mangled by console codepages - an earlier attempt to inline the
rem  script directly was destroyed by cmd mangling Cyrillic text.
rem
rem  Run under the SENET CLIENT account, not Support.
rem ------------------------------------------------------------------
chcp 65001 >nul
title Orda - SENET scan
setlocal
set "B64=%TEMP%\orda-senet-scan.b64"
set "PS1=%TEMP%\orda-senet-scan.ps1"
if exist "%B64%" del /q "%B64%"
if exist "%PS1%" del /q "%PS1%"

echo.
echo   SENET scan. Nothing is uploaded - local inspection only.
echo   Please wait...
echo.

