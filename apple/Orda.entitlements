<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push-уведомления. `development` для отладочных сборок; в архиве для
	     App Store Xcode подставит production автоматически.
	     Значение должно соответствовать APNS_ENVIRONMENT на сервере. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
