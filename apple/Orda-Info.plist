<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Обязательный минимум. Xcode подставляет эти ключи сам, только когда
	     генерирует Info.plist; у нас файл свой, поэтому пишем их явно —
	     без CFBundleIdentifier симулятор откажется ставить сборку. -->
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>

	<key>CFBundleDisplayName</key>
	<string>Orda</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- Адрес сайта. Приходит из Config.xcconfig, читается в AppConfiguration.
	     Больше приложению настраивать нечего: всё остальное — через API. -->
	<key>ORDA_API_BASE_URL</key>
	<string>$(ORDA_API_BASE_URL)</string>

	<!-- Face ID: без описания система не покажет запрос и вход молча не сработает. -->
	<key>NSFaceIDUsageDescription</key>
	<string>Для быстрого и безопасного входа в Orda.</string>
	<!-- Камера нужна сканеру штрихкодов и съёмке чеков при заведении расхода.
	     Описание обязано перечислять оба: разрешение спрашивают один раз, и
	     текст про одни штрихкоды выглядел бы обманом, когда приложение просит
	     камеру ради документа. -->
	<key>NSCameraUsageDescription</key>
	<string>Сканирование штрихкодов товара и съёмка чеков при заведении расхода.</string>

	<!-- Микрофон: голосовые в чате. Без описания система не покажет запрос, а
	     приложение упадёт на первой же записи. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Запись голосовых сообщений в чат команды.</string>

	<!-- Ссылки orda://page/<страница>: переход в раздел из уведомления,
	     заметки или служебного скрипта. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>kz.ordaops.apple.page</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>orda</string>
			</array>
		</dict>
	</array>

	<!-- Экспортное соответствие. Приложение шифрует только тем, что даёт
	     система: HTTPS к сайту и Keychain для сессии. Такое использование
	     освобождено от экспортных ограничений, и без этого ключа App Store
	     Connect задаёт вопрос при каждой загрузке сборки. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Ориентации экрана.
	     Они были заданы настройками сборки (INFOPLIST_KEY_…), но те
	     подмешиваются только в Info.plist, который Xcode генерирует сам. У нас
	     файл свой, и до сборки они не доезжали: App Store отклонял загрузку с
	     кодом 90474 «No orientations were specified».

	     На iPad обязательны все четыре — иначе не работает многозадачность и
	     приложение нельзя показать рядом с другим. На iPhone «вверх ногами» не
	     нужен: телефон в этом положении держат разве что случайно. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
</dict>
</plist>
