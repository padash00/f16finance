// Настройки сборки.
//
// Приложение общается только с сайтом. Никаких ключей Supabase здесь нет и не
// должно быть: обмен пароля на токен делает сервер в /api/auth/mobile-session,
// поэтому ключ проекта не покидает бэкенд.
//
// ВАЖНО: xcconfig трактует `//` как начало комментария, поэтому схему в URL
// писать нельзя. Указывается только хост — https:// добавит AppConfiguration.

// Адрес сайта. По умолчанию — прод; для стенда поменяйте на свой хост.
ORDA_API_BASE_URL = www.ordaops.kz

// Идентификатор приложения. Должен совпадать с APNS_BUNDLE_ID на сервере.
PRODUCT_BUNDLE_IDENTIFIER = kz.ordaops.apple

// Команда разработчика Apple: ТОО «Turanix». Нужен для подписи архива —
// без него Xcode не соберёт сборку для App Store.
DEVELOPMENT_TEAM = YRA24D32N2
