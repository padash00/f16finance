NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=https://your-app-domain.vercel.app

# Отображаемое имя продукта в интерфейсе (welcome, сайдбар, логин). По умолчанию: Orda Control
# NEXT_PUBLIC_SITE_NAME=Моя платформа
# Короткая марка в квадрате логотипа (1–3 символа). Если не задано — берутся первые буквы из названия
# NEXT_PUBLIC_PRODUCT_MARK=МП

# Optional fallback for server-side admin client if NEXT_PUBLIC_SUPABASE_URL is not used there
SUPABASE_URL=https://your-project.supabase.co
APP_URL=https://your-app-domain.vercel.app

# Required for admin auth actions: staff invites, account creation, privileged writes
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# REQUIRED: super admin email list (comma-separated). If not set, super-admin access is disabled.
ADMIN_EMAILS=your-admin@email.com

# Текст бренда в Telegram (шапка/подвал). По умолчанию = NEXT_PUBLIC_SITE_NAME, иначе Orda Control
# ORDA_TELEGRAM_BRAND_NAME=Моя платформа
# Короткая подпись сайта в подвале сообщений (без https). Иначе — hostname из NEXT_PUBLIC_APP_URL / APP_URL
# ORDA_TELEGRAM_FOOTER_SITE=ordaops.kz

# Required for Telegram notifications from tasks, shifts and reports
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Admin chat ID for deficit shift alerts (can be personal chat or group)
TELEGRAM_ADMIN_CHAT_ID=your-chat-id
# Private chat ID where superadmin receives human-readable leader activity feed
TELEGRAM_SUPERADMIN_CHAT_ID=your-private-superadmin-chat-id

# REQUIRED for Telegram webhook verification — без этой переменной webhook полностью заблокирован
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret

# Optional: fallback provider for AI actions when OpenAI is unavailable
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Public site lead form via SMTP/Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Orda Control Site <your-email@gmail.com>"
CONTACT_LEAD_TO=padash00@gmail.com

# Push-уведомления на iPhone/iPad (APNs). Без них сервер молча ничего не шлёт:
# задача, личное сообщение и упоминание в чате уходят в пустоту.
# Ключ заводится один раз: Apple Developer → Keys → Apple Push Notifications
# service. Файл AuthKey_XXXXXXXXXX.p8 скачивается ровно один раз.
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=YRA24D32N2
# Содержимое .p8 целиком: PEM с переносами строк или та же строка в base64.
APNS_PRIVATE_KEY=base64-содержимое-AuthKey.p8
APNS_BUNDLE_ID=kz.ordaops.apple
# production — боевые сборки из App Store и TestFlight, sandbox — сборка с Mac
# на устройство. Должно совпадать с APS_ENVIRONMENT в настройках сборки.
APNS_ENVIRONMENT=production
